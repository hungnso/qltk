<config>
	<devices>
		<device DEFAULT="true">
			<name>Resizable device</name>
			<filename/>
			<descriptor>org/microemu/device/resizable/device.xml</descriptor>
		</device>
		<device>
			<name>NST Gray</name>
			<filename/>
			<descriptor>org/microemu/device/resizable/gray_device.xml</descriptor>
		</device>
		<device>
			<name>NST Black</name>
			<filename/>
			<descriptor>org/microemu/device/resizable/black_device.xml</descriptor>
		</device>
	</devices>
	<files>
		<recent MAXCAPACITY="10"/>
	</files>
	<system-properties>
		<system-property VALUE="MIDP-2.0" NAME="microedition.profiles"/>
		<system-property VALUE="CLDC-1.0" NAME="microedition.configuration"/>
		<system-property VALUE="true" NAME="avetana.forceNativeLibrary"/>
	</system-properties>
	<windows>
		<main ONSTART="true">
			<x>166</x>
			<y>263</y>
			<width>171</width>
			<height>263</height>
		</main>
	</windows>
	<chipAutoSleep ENABLED="false"/>
</config>
